{
  "name": "desktop",
  "projectType": "application",
  "implicitDependencies": ["runtime"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedBuild", "{workspaceRoot}/electron-builder.config.cjs", "{workspaceRoot}/build/**/*"]
  },
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "node scripts/build.mjs --app desktop" } },
    "verify": { "executor": "nx:run-commands", "options": { "command": "node scripts/build.mjs --verify-only --app desktop" } }
  }
}
