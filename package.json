{
  "name": "organis-workspace",
  "version": "0.1.0-beta.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "workspaces": [
    "apps/cli",
    "apps/desktop",
    "packages/runtime"
  ],
  "scripts": {
    "start": "electron apps/desktop",
    "cli": "node apps/cli/src/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "nx run-many -t build --projects=cli,desktop --parallel=1",
    "build:cli": "nx run cli:build",
    "build:desktop": "nx run desktop:build",
    "build:affected": "nx affected -t build --parallel=1",
    "verify:platform": "nx run-many -t verify --projects=cli,desktop --parallel=1",
    "smoke:desktop": "electron apps/desktop --smoke-test"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "nx": "24.0.5",
    "tar": "7.5.22"
  }
}
