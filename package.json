{
  "name": "organis-workspace",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.22.2" },
  "workspaces": ["apps/cli", "apps/desktop", "packages/runtime"],
  "scripts": {
    "start": "electron apps/desktop",
    "cli": "node apps/cli/src/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "smoke:desktop": "electron apps/desktop --smoke-test"
  },
  "overrides": { "glob": "14.0.4", "minimatch": "11.0.5" },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.3",
    "tar": "7.5.22"
  }
}
